// Cloud rows never send their 64-bit identities through a Slint int.
export global CloudTrackActions {
    callback enqueue(string /*song ID*/, bool /*play next*/);
    callback toggle-favorite(string /*song ID*/, bool /*liked*/);
    callback open-album(string /*NetEase album ID*/);
    callback open-artist(string /*NetEase artist ID*/);
    callback open-mv(string /*NetEase MV ID*/);
}
