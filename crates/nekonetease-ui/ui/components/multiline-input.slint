import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { OverlayScrollbar } from "overlay-scrollbar.slint";

// The tree's only multi-line, word-wrapping text box — every other `TextInput`
// is single-line, and std-widgets' `TextEdit` forwards no appearance properties,
// so it can't be themed to match a dialog. The scrolling recipe comes from
// Slint's own `widgets/common/textedit-base.slint`; the chrome from
// `labeled-input.slint`.
//
// **Never put `border-radius` + `clip: true` on the box holding the
// `TextInput`**: a rounded clip renders the text into a texture. The root paints
// the rounded fill and border as one shape, which the renderer antialiases once,
// and the inner `ScrollView` clips its viewport rectangularly, inset by `pad` so
// nothing it scrolls reaches the border. The `PickerListCard` shape.
export component MultilineInput inherits Rectangle {
    in property <string> placeholder;
    // A host on a surface quieter than `surface1` raises this so the hint still reads.
    in property <brush> placeholder-color: Theme.overlay2;
    in-out property <string> text;
    callback edited();

    // Every visible child is positioned by `x`/`y`, which layout info skips, so without a floor
    // of its own the box reports zero and a host's stretch has nothing to divide.
    min-width: 96px;
    min-height: 20px;

    public function focus-input() {
        ti.focus();
    }

    // The text's inset from the border. A host that sizes the box to one compact line lowers
    // this; the default keeps the dialog fields' breathing room.
    in property <length> pad: Theme.pad-sm;
    // Drop the box's chrome — fill, border and radius — leaving the text on whatever ground the
    // host paints. The comments composer sits in its own bar and wants only the text there.
    in property <bool> flat: false;

    background: root.flat ? transparent : Theme.surface1;
    border-radius: root.flat ? 0px : Theme.radius-md;
    border-width: root.flat ? 0px : 1px;
    border-color: ti.has-focus ? Theme.accent : Theme.border;
    animate border-color { duration: Theme.dur-fast; easing: ease-in-out; }

    sv := ScrollView {
        x: root.pad;
        y: root.pad;
        width: parent.width - 2 * root.pad;
        height: parent.height - 2 * root.pad;
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: always-off;
        // Width locked to the viewport so lines wrap instead of scrolling
        // sideways. The height's `max` is required: without it the viewport
        // never grows past what's visible, so there is no vertical travel, the
        // caret-nudge handler has nothing to scroll, and long text runs off the
        // bottom.
        viewport-width: self.visible-width;
        viewport-height: max(self.visible-height, ti.preferred-height);

        ti := TextInput {
            text <=> root.text;
            color: Theme.text;
            font-size: Theme.font-size-md;
            single-line: false;
            wrap: word-wrap;
            page-height: sv.visible-height;
            edited => { root.edited(); }
            // Keeps the caret on screen. Word-wrap makes the x-axis inert, so
            // only upstream's y-branch survives — with the line height derived
            // from the font size rather than hardcoded as upstream does.
            cursor-position-changed(cpos) => {
                if (cpos.y + sv.viewport-y < 12px) {
                    sv.viewport-y = min(0px, max(sv.visible-height - self.height, -cpos.y + 12px));
                } else if (cpos.y + sv.viewport-y > sv.visible-height - 12px - Theme.font-size-md * 1.5) {
                    sv.viewport-y = min(0px, max(sv.visible-height - self.height, sv.visible-height - cpos.y - 12px - Theme.font-size-md * 1.5));
                }
            }
        }
    }

    // Faked, because `TextInput` has no `placeholder-text`.
    Text {
        x: sv.x;
        y: sv.y;
        width: sv.width;
        vertical-alignment: top;
        text: root.text == "" ? root.placeholder : "";
        color: root.placeholder-color;
        font-size: Theme.font-size-md;
        wrap: word-wrap;
    }

    OverlayScrollbar {
        horizontal: false;
        track-color: Theme.scrollbar-track-on-card;
        x: parent.width - self.width - 2px;
        y: root.pad;
        width: Theme.scrollbar-slot;
        height: parent.height - 2 * root.pad;
        visible-size: sv.visible-height;
        content-size: sv.viewport-height;
        offset: -sv.viewport-y;
        scroll-to(o) => { sv.viewport-y = -o; }
    }
}
